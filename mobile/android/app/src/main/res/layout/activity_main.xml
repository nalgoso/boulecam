<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- Camera Preview with Responsive Orientation & Aspect Ratio (Zero Distortion) -->
    <com.boulecam.ui.AutoFitTextureView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- Top Status Bar (Glassmorphic HUD) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#DD000000"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Official Brand Logo + Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_app_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/app_logo"
                android:scaleType="fitCenter"
                android:contentDescription="BouleCam Logo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BouleCam"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Sleek Circular Pill Toggle (USB / Wi-Fi) -->
        <FrameLayout
            android:id="@+id/layout_mode_toggle"
            android:layout_width="86dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_toggle_pill"
            android:padding="3dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_toggle_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:text="Wi-Fi"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:id="@+id/toggle_thumb"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_toggle_circle">

                <TextView
                    android:id="@+id/txt_thumb_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="USB"
                    android:textColor="#006D3B"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Unified Floating Camera Quick Control Dock (Identical to Desktop Studio) -->
    <LinearLayout
        android:id="@+id/video_quick_dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_panel"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dock_glass"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:elevation="10dp">

        <!-- Flip Camera (Front / Back Lens) -->
        <ImageButton
            android:id="@+id/btn_dock_flip"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_flip"
            android:contentDescription="Girar Cámara (Frontal / Trasera)"
            app:tint="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <!-- Torch / Flash -->
        <ImageButton
            android:id="@+id/btn_dock_torch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_torch"
            android:contentDescription="Linterna / Flash"
            app:tint="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <!-- Microphone -->
        <ImageButton
            android:id="@+id/btn_dock_mic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_mic"
            android:contentDescription="Micrófono"
            app:tint="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <!-- Mirror (Espejar Video) -->
        <ImageButton
            android:id="@+id/btn_dock_mirror"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_mirror"
            android:contentDescription="Espejar Pantalla"
            app:tint="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <!-- Rotate 180 (Invert orientation) -->
        <ImageButton
            android:id="@+id/btn_dock_rotate_180"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_rotate"
            android:contentDescription="Rotar 180°"
            app:tint="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <!-- Dim Screen (Atenuar pantalla) -->
        <ImageButton
            android:id="@+id/btn_dock_dim"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_dim"
            android:contentDescription="Atenuar pantalla"
            app:tint="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <!-- Pro Settings Toggle -->
        <ImageButton
            android:id="@+id/btn_dock_pro"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dock_btn"
            android:src="@drawable/ic_cam_tune"
            android:contentDescription="Ajustes de Cámara"
            app:tint="#4ADE80" />
    </LinearLayout>

    <!-- Bottom Status & Pro Controls Container -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#DD222222"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Status & Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STATUS: ESPERANDO CONEXIÓN"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p @ 60 FPS"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Collapsible Pro Controls Panel (Scrollable for compact heights in Landscape) -->
        <ScrollView
            android:id="@+id/pro_controls_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="160dp">

            <LinearLayout
                android:id="@+id/pro_controls_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <!-- ISO Slider Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:id="@+id/lbl_iso"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="ISO: Auto"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/seek_iso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="6"
                        android:progress="0" />
                </LinearLayout>

                <!-- Exposure Compensation (EV) Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:id="@+id/lbl_ev"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="EV: 0"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/seek_ev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="12"
                        android:progress="6" />
                </LinearLayout>

                <!-- White Balance Selector Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:id="@+id/lbl_wb"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="WB: Auto"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/seek_wb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="5"
                        android:progress="0" />
                </LinearLayout>

                <!-- Manual Focus Slider Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/lbl_focus"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Focus: AF"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/seek_focus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Full Screen Battery Saver Dim Screen Overlay (AMOLED Pure Black) -->
    <FrameLayout
        android:id="@+id/dim_screen_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="100dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙"
                android:textSize="32sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BouleCam • Pantalla Atenuada"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transmitiendo en vivo • Toca la pantalla para restaurar el brillo"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
