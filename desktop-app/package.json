{
  "name": "boulecam",
  "productName": "BouleCam",
  "version": "1.4.09",
  "description": "Puente y control de camara movil de alta definicion para transmisiones en vivo",
  "main": "main.js",
  "author": "Iglesia Boulevard Guzman <contacto@iglesiaboulevardguzman.com.ar>",
  "homepage": "https://iglesiaboulevardguzman.com.ar",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "camara",
    "webcam",
    "transmision",
    "boulecam",
    "iglesiaboulevardguzman"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ar.com.iglesiaboulevardguzman.boulecam",
    "productName": "BouleCam",
    "copyright": "Copyright 2026 Iglesia Boulevard Guzman",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-v${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../build/Release/boulecam-desktop.exe",
        "to": "bin/boulecam-desktop.exe"
      },
      {
        "from": "../build/Release/boulecam-vcam.dll",
        "to": "bin/boulecam-vcam.dll"
      },
      {
        "from": "../build/Release/register_vcam.exe",
        "to": "bin/register_vcam.exe"
      }
    ]
  }
}
